[node name="Teeth" type="Parallax2D" parent="Control/CanvasGroup/TopBanner" unique_id=1278267242]
editor_description = "锯齿条：Tooth 里画的是一整排 1920 宽的齿（编辑器里也完整可见）。repeat_size.x = 一排版宽 = 1920，autoscroll.x 为负 = 向左滚；repeat_times 按重复次数铺余量（重复是以内容为中心向两侧铺，4 份 = ±3840，1920 屏足够），给 -1 在无相机场景里不会自动铺满。"
repeat_size = Vector2(1920, 0)
autoscroll = Vector2(-40, 0)
repeat_times = 4

