[sub_resource type="GDScript" id="GDScript_8ejbx"]
script/source = "extends Label

var player_movement: PlayerMovement
var player_interaction: Node

var last_pipe_state := false
var last_pipe_direction := \"\"
var last_position := Vector2.ZERO
var last_pipe_timer := 0
var last_transport_state := false
var frame_count := 0

var last_turning_area_count := 0
var last_overlapped_turning_areas := []

func _ready() -> void:
	var player = get_tree().get_first_node_in_group(\"player\")
	if player:
		player_movement = player.get_meta(\"player_movement\")
		player_interaction = player.get_meta(\"player_interaction\")
		if player_movement.has_signal(\"pipe_exited\"):
			player_movement.pipe_exited.connect(_on_pipe_exited)
		print(\"[管道调试] 初始化完成，玩家: \", player.name)
	else:
		print(\"[管道调试] 错误：未找到玩家节点\")

func _physics_process(delta: float) -> void:
	frame_count += 1
	_update_display_text()
	if frame_count % 5 == 0:
		_debug_pipe_state_changes()
		_debug_turning_areas()

func _update_display_text() -> void:
	if not player_movement or not player_interaction:
		text = \"管道调试标签\\n未找到玩家组件\"
		return

	text = \"=== 管道调试信息 ===\\n\"
	text += \"帧数: %d\\n\" % frame_count
	text += \"位置: (%.1f, %.1f)\\n\" % [player_movement.player.position.x, player_movement.player.position.y]
	text += \"速度: (%.1f, %.1f)\\n\" % [player_movement.speed_x, player_movement.speed_y]
	text += \"目标速度: %.1f\\n\" % player_movement.target_speed
	text += \"移动输入: 左:%s 右:%s 上:%s 下:%s\\n\" % [
		player_movement.move_left, player_movement.move_right,
		player_movement.move_up, player_movement.move_down
	]

	text += \"\\n=== 管道状态 ===\\n\"
	text += \"在管道中: %s\\n\" % player_movement.is_in_pipe
	text += \"在传送中: %s\\n\" % player_movement.is_in_transport
	text += \"管道方向: %s\\n\" % _get_pipe_direction_name(player_movement.pipe_moving_dir)
	text += \"pipe_get_close_timer: %d\\n\" % player_interaction.pipe_get_close_timer
	text += \"对齐标志: %s\\n\" % player_interaction.is_origin_pipe_dir_set
	if player_interaction.is_origin_pipe_dir_set:
		text += \"原始方向: %s\\n\" % _get_pipe_direction_name(player_interaction.origin_player_pipe_dir)

	# 转向区域信息
	var turning_areas = get_tree().get_nodes_in_group(\"clear_pipe_turning\")
	var nearby = []
	for area in turning_areas:
		if area.global_position.distance_to(player_movement.player.position) < 100.0:
			nearby.append(area)

	text += \"\\n=== 转向区域检测 ===\\n\"
	text += \"附近转向区域: %d个\\n\" % nearby.size()
	for i in range(nearby.size()):
		var area = nearby[i]
		var dir_name = _get_turning_direction_name(area.direction)
		var processed = area.has_meta(\"processed\")
		text += \"区域%d: %s (已处理:%s) 距离:%.1f\\n\" % [i+1, dir_name, processed, area.global_position.distance_to(player_movement.player.position)]

	text += \"\\n=== 其他状态 ===\\n\"
	text += \"无敌星: %s\\n\" % player_interaction.is_starman()
	text += \"蹲下: %s\\n\" % player_movement.crouch
	text += \"跳跃: %s\\n\" % player_movement.move_jump

func _get_pipe_direction_name(dir) -> String:
	match dir:
		PlayerMovement.PipeMoveDirection.LEFT:   return \"左\"
		PlayerMovement.PipeMoveDirection.RIGHT:  return \"右\"
		PlayerMovement.PipeMoveDirection.UP:     return \"上\"
		PlayerMovement.PipeMoveDirection.DOWN:   return \"下\"
		PlayerMovement.PipeMoveDirection.ALIGN:  return \"对齐中\"
		_: return \"未知\"

func _get_turning_direction_name(dir) -> String:
	match dir:
		0: return \"左\"
		1: return \"右\"
		2: return \"上\"
		3: return \"下\"
		4: return \"左上\"
		5: return \"左下\"
		6: return \"右上\"
		7: return \"右下\"
		_: return \"未知\"

func _debug_pipe_state_changes() -> void:
	if not player_movement or not player_interaction:
		return

	if player_movement.is_in_pipe != last_pipe_state:
		print(\"[管道调试] 帧 %d - 管道状态变化: %s -> %s\" % [frame_count, \"在管道中\" if last_pipe_state else \"不在管道\", \"在管道中\" if player_movement.is_in_pipe else \"不在管道\"])
		last_pipe_state = player_movement.is_in_pipe

	if player_movement.is_in_transport != last_transport_state:
		print(\"[管道调试] 帧 %d - 传送状态变化: %s -> %s\" % [frame_count, \"传送中\" if last_transport_state else \"非传送\", \"传送中\" if player_movement.is_in_transport else \"非传送\"])
		last_transport_state = player_movement.is_in_transport

	var cur_dir = _get_pipe_direction_name(player_movement.pipe_moving_dir)
	if cur_dir != last_pipe_direction:
		print(\"[管道调试] 帧 %d - 管道方向变化: %s -> %s\" % [frame_count, last_pipe_direction, cur_dir])
		last_pipe_direction = cur_dir

	if player_interaction.pipe_get_close_timer != last_pipe_timer:
		print(\"[管道调试] 帧 %d - pipe_get_close_timer变化: %d -> %d\" % [frame_count, last_pipe_timer, player_interaction.pipe_get_close_timer])
		last_pipe_timer = player_interaction.pipe_get_close_timer

	if player_movement.is_in_pipe and player_interaction.pipe_get_close_timer > 0:
		print(\"[管道调试] 帧 %d - 管道中timer激活: %d\" % [frame_count, player_interaction.pipe_get_close_timer])

func _debug_turning_areas() -> void:
	if not player_movement:
		return

	var areas = get_tree().get_nodes_in_group(\"clear_pipe_turning\")
	var current = []
	for area in areas:
		if area.global_position.distance_to(player_movement.player.position) < 50.0:
			current.append({
				\"area\": area,
				\"direction\": _get_turning_direction_name(area.direction),
				\"processed\": area.has_meta(\"processed\"),
				\"distance\": area.global_position.distance_to(player_movement.player.position)
			})

	if current.size() != last_turning_area_count:
		print(\"[管道调试] 帧 %d - 附近转向区域数量变化: %d -> %d\" % [frame_count, last_turning_area_count, current.size()])
		last_turning_area_count = current.size()

	for data in current:
		var was_processed = false
		for old in last_overlapped_turning_areas:
			if old[\"area\"] == data[\"area\"] and old[\"processed\"]:
				was_processed = true
				break
		if data[\"processed\"] != was_processed:
			print(\"[管道调试] 帧 %d - 区域%s 处理状态变化: %s -> %s (距离:%.1f)\" % [frame_count, data[\"direction\"], \"已处理\" if was_processed else \"未处理\", \"已处理\" if data[\"processed\"] else \"未处理\", data[\"distance\"]])

	last_overlapped_turning_areas = current

func _on_pipe_exited() -> void:
	print(\"[管道调试] 管道退出信号触发，帧数: %d\" % frame_count)
	if player_movement:
		print(\"[管道调试] 退出时位置: (%.1f, %.1f)\" % [player_movement.player.position.x, player_movement.player.position.y])
		print(\"[管道调试] 退出时方向: %s\" % _get_pipe_direction_name(player_movement.pipe_moving_dir))
"

