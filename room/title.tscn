[sub_resource type="GDScript" id="GDScript_rm4w4"]
script/source = "extends TextureButton

func _ready() -> void:
	pressed.connect(_on_button_pressed)
	
func _on_button_pressed():
	# Mario Forever 社区
	OS.shell_open(\"https://www.marioforever.net/\")
	
"

