custom_minimum_size = Vector2(233, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
text = "
欢迎游玩 Mario Forever Party: King Designer！

Mario Forever Party: King Designer 是有 DIY 属性的游戏，因此，在游玩过程中，请确保：
· 创作的关卡内容符合公序良俗，不得包含暴力、色情、低俗、歧视、恐怖等不良及违法违规内容
· 遵守当地法律法规
· 不得利用关卡创作功能制作、传播恶意代码、病毒，或设计诱导玩家设备故障、信息泄露的恶意关卡

关卡存储说明：
· 考虑到关卡复用，你创作的关卡在联机游玩过程中会被其他玩家自动缓存至其本地设备；同样地，其他玩家创作的关卡也会被自动缓存至你的本地设备。"
autowrap_mode = 3

