; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="MFP: KD"
run/main_scene="uid://bijt3ar5fx2ad"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(1, 1, 1, 1)
boot_splash/stretch_mode=0
boot_splash/use_filter=false
boot_splash/image="uid://bijlbaumcevx5"
config/icon="uid://bijlbaumcevx5"

[autoload]

InputHandlerSingleton="*res://object/utils/input_handler.tscn"
PlatformUtilsSingleton="*res://object/utils/platform_utils.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[dotnet]

project/assembly_name="Mario Forever Party- King Designer"

[file_customization]

folder_colors={
"res://database/": "gray",
"res://object/background/": "green",
"res://room/": "purple",
"res://script/": "gray",
"res://shader/": "gray",
"res://sound/": "blue"
}

